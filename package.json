{
  "name": "@coreplane/whodunit",
  "version": "0.1.0",
  "description": "Trace local failures through code, relevant history and agent context.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "whodunit": "bin/whodunit.mjs"
  },
  "exports": {
    ".": {
      "types": "./skill/whodunit/scripts/lib/index.d.ts",
      "import": "./skill/whodunit/scripts/lib/index.js"
    }
  },
  "files": [
    "bin",
    "skill/whodunit",
    "README.md"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "test": "bun test --isolate",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test && node scripts/check-package.mjs",
    "prepublishOnly": "npm run verify",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@types/node": "22.18.8",
    "@types/bun": "1.3.0",
    "@biomejs/biome": "2.5.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreplanelabs/whodunit.git"
  },
  "homepage": "https://debug.polycorp.foo",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
